{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nothing X",
  "version": "1.0.0",
  "identifier": "com.nothing.smartcenter.desktop",
  "build": {
    "beforeDevCommand": "node scripts/free-port.mjs && npm run dev",
    "devUrl": "http://localhost:1435",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nothing X",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
